    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfunction findSubtitleSmart(subtitleInfos, preferredLang = 'vie-VN') {\n  if (!subtitleInfos || !Array.isArray(subtitleInfos) || subtitleInfos.length === 0) return null;\n  const version1Sub = subtitleInfos.find(s => { const ver = String(s.Version || ''); return ver === '1' || ver.startsWith('1:'); });\n  if (version1Sub) return version1Sub;\n  const preferredSub = subtitleInfos.find(s => s.LanguageCodeName === preferredLang);\n  if (preferredSub) return preferredSub;\n  return subtitleInfos[0] || null;\n}\n\nfunction findSubtitleFromClaInfo(claInfo, preferredLang = 'vie-VN') {\n  if (!claInfo?.captionInfos?.length) return null;\n  const captions = claInfo.captionInfos;\n  const version1Cap = captions.find(c => { const variant = String(c.variant || ''); return variant === '1' || variant.startsWith('1:'); });\n  if (version1Cap) return version1Cap;\n  const preferredCap = captions.find(c => c.language === preferredLang);\n  if (preferredCap) return preferredCap;\n  return captions[0] || null;\n}\n\nfor (const item of items) {\n  const html = item.json.data;\n  const tiktokUrl = $('Set TikTok URL1').first().json.tiktok_url;\n  const videoIdMatch = tiktokUrl.match(/\\/video\\/(\\d+)/);\n  const videoId = videoIdMatch ? videoIdMatch[1] : null;\n  if (!videoId) { results.push({ json: { error: 'Cannot extract video ID', url: tiktokUrl } }); continue; }\n\n  const marker = '<script id=\"__UNIVERSAL_DATA_FOR_REHYDRATION__\" type=\"application/json\">';\n  const startIdx = html.indexOf(marker);\n  if (startIdx === -1) { results.push({ json: { error: 'Cannot find JSON data in HTML', videoId } }); continue; }\n\n  const jsonStart = startIdx + marker.length;\n  const jsonEnd = html.indexOf('</script>', jsonStart);\n  let itemStruct;\n  try {\n    const data = JSON.parse(html.substring(jsonStart, jsonEnd));\n    itemStruct = data?.['__DEFAULT_SCOPE__']?.['webapp.video-detail']?.['itemInfo']?.['itemStruct'];\n  } catch (e) { results.push({ json: { error: 'JSON parse failed: ' + e.message, videoId } }); continue; }\n  if (!itemStruct) { results.push({ json: { error: 'itemStruct not found', videoId } }); continue; }\n\n  const stats = itemStruct.statsV2 || itemStruct.stats || {};\n  const video = itemStruct.video || {};\n  const author = itemStruct.author || {};\n  const subtitleInfos = video.subtitleInfos || [];\n  const claInfo = video.claInfo || null;\n  const hasOriginalAudio = claInfo?.hasOriginalAudio || false;\n\n  let finalSubtitle = findSubtitleSmart(subtitleInfos, 'vie-VN');\n  if (!finalSubtitle && claInfo?.captionInfos?.length) {\n    const claFallback = findSubtitleFromClaInfo(claInfo, 'vie-VN');\n    if (claFallback) {\n      finalSubtitle = { Url: claFallback.url, Version: claFallback.variant, LanguageCodeName: claFallback.language };\n    }\n  }\n\n  results.push({ json: {\n    id: itemStruct.id, desc: itemStruct.desc,\n    create_time: itemStruct.createTime ? new Date(itemStruct.createTime * 1000).toISOString() : null,\n    author: author.uniqueId, author_nickname: author.nickname,\n    play_count: stats.playCount, like_count: stats.diggCount,\n    comment_count: stats.commentCount, share_count: stats.shareCount, collect_count: stats.collectCount,\n    duration: video.duration,\n    hashtags: (itemStruct.challenges || []).map(c => c.title).join(', '),\n    subtitle_url: finalSubtitle?.Url || null,\n    has_subtitle: (subtitleInfos.length > 0) || (claInfo?.captionInfos?.length > 0),\n    has_original_audio: hasOriginalAudio,\n    tiktok_url: tiktokUrl\n  }});\n}\nreturn results;"
      },
      "id": "aec3983b-ae3b-418a-b8d1-e72bf5766ee0",
      "name": "Parse TikTok Metadata1",
