      "id": "39a55098-f078-4241-b807-eefb8606b6c7",
      "name": "Fetch Subtitle1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        2448,
        -288
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const vttContent = item.json.data || '';\n  const seen = new Set();\n  const textLines = vttContent.split('\\n').filter(line => {\n    const t = line.trim();\n    return t && t !== 'WEBVTT' && !t.includes('-->') && !/^\\d+$/.test(t);\n  }).filter(line => {\n    const trimmed = line.trim();\n    if (seen.has(trimmed)) return false;\n    seen.add(trimmed);\n    return true;\n  });\n  results.push({ json: { subtitle: textLines.join(' ').trim(), transcript: '' } });\n}\nreturn results;"
      },
